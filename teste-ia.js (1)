// =====================================
// CLOSERAI - CHAT DE TESTE + MEMÓRIA
// =====================================

const chat =
    document.getElementById("chat");

const mensagem =
    document.getElementById("mensagem");

const btnEnviar =
    document.getElementById("btnEnviar");

const btnLimpar =
    document.getElementById("btnLimpar");

const status =
    document.getElementById("status");

let conhecimento = null;

const empresaId =
    localStorage.getItem("empresaId");

// ID do cliente criado para esta sessão de teste
let clienteTesteId =
    localStorage.getItem(
        "closerAI_clienteTeste_" + empresaId
    );


// =====================================
// CARREGAR CONHECIMENTO DA IA
// =====================================

async function carregarIA() {

    if (!empresaId) {

        status.textContent =
            "❌ Empresa não encontrada.";

        return;
    }


    const { data, error } =
        await supabaseClient

            .from("conhecimento")

            .select("*")

            .eq(
                "empresa_id",
                empresaId
            )

            .order(
                "created_at",
                {
                    ascending: false
                }
            )

            .limit(1);


    if (error) {

        console.error(
            "❌ Erro ao carregar conhecimento:",
            error
        );

        status.textContent =
            "❌ Erro ao carregar conhecimento.";

        return;
    }


    if (
        data &&
        data.length > 0
    ) {

        conhecimento =
            data[0];


        console.log(
            "🧠 Conhecimento carregado:",
            conhecimento
        );


        status.textContent =
            "🟢 IA pronta para teste.";

    } else {

        conhecimento = {};


        status.textContent =
            "⚠️ Nenhum conhecimento encontrado.";

    }

}


// =====================================
// CRIAR / RECUPERAR CLIENTE DO TESTE
// =====================================

async function obterClienteTeste() {

    if (!empresaId) {

        return null;

    }


    // =================================
    // SE JÁ TEMOS O ID LOCALMENTE
    // =================================

    if (clienteTesteId) {

        const {
            data: clienteExistente,
            error: erroCliente
        } = await supabaseClient

            .from("clientes")

            .select("*")

            .eq(
                "id",
                clienteTesteId
            )

            .eq(
                "empresa_id",
                empresaId
            )

            .maybeSingle();


        if (
            !erroCliente &&
            clienteExistente
        ) {

            console.log(
                "👤 Cliente de teste recuperado:",
                clienteExistente
            );

            return clienteExistente;

        }

    }


    // =================================
    // CRIAR NOVO CLIENTE
    // =================================

    console.log(
        "👤 Criando cliente de teste..."
    );


    const novoCliente = {

        empresa_id:
            empresaId,

        nome:
            "Cliente de Teste",

        email:
            "cliente.teste@closerai.local",

        telefone:
            "",

        canal:
            "Teste da IA",

        status:
            "Novo"

    };


    const {
        data,
        error
    } = await supabaseClient

        .from("clientes")

        .insert([
            novoCliente
        ])

        .select()

        .single();


    if (error) {

        console.error(
            "❌ Erro ao criar cliente:",
            error
        );

        return null;

    }


    clienteTesteId =
        data.id;


    localStorage.setItem(
        "closerAI_clienteTeste_" + empresaId,
        clienteTesteId
    );


    console.log(
        "✅ Cliente de teste criado:",
        data
    );


    return data;

}


// =====================================
// CARREGAR HISTÓRICO DA EMPRESA
// =====================================

async function carregarHistorico() {

    if (!empresaId) return;


    const {
        data,
        error
    } = await supabaseClient

        .from("conversas")

        .select("*")

        .eq(
            "empresa_id",
            empresaId
        )

        .order(
            "created_at",
            {
                ascending: true
            }
        );


    if (error) {

        console.error(
            "❌ Erro ao carregar histórico:",
            error
        );

        return;

    }


    if (
        !data ||
        data.length === 0
    ) {

        return;

    }


    data.forEach(
        function (conversa) {

            adicionarMensagemUsuario(
                conversa.mensagem_cliente
            );


            adicionarMensagemIA(
                conversa.resposta_ia
            );

        }
    );


    chat.scrollTop =
        chat.scrollHeight;

}


// =====================================
// MENSAGEM DO UTILIZADOR
// =====================================

function adicionarMensagemUsuario(
    texto
) {

    chat.innerHTML += `

        <div style="
            display:flex;
            justify-content:flex-end;
            margin:15px 0;
        ">

            <div class="card">

                👤 ${escaparHTML(texto)}

            </div>

        </div>

    `;

}


// =====================================
// RESPOSTA DA IA
// =====================================

function adicionarMensagemIA(
    texto
) {

    chat.innerHTML += `

        <div style="
            display:flex;
            justify-content:flex-start;
            margin:15px 0;
        ">

            <div class="card glow">

                🤖 ${escaparHTML(texto)}

            </div>

        </div>

    `;

}


// =====================================
// BOTÃO ENVIAR
// =====================================

btnEnviar.addEventListener(
    "click",
    enviarMensagem
);


// =====================================
// ENTER PARA ENVIAR
// =====================================

mensagem.addEventListener(
    "keydown",
    function(event) {

        if (
            event.key === "Enter" &&
            !event.shiftKey
        ) {

            event.preventDefault();

            enviarMensagem();

        }

    }
);


// =====================================
// ENVIAR MENSAGEM
// =====================================

async function enviarMensagem() {

    const texto =
        mensagem.value.trim();


    if (!texto) {

        return;

    }


    if (!empresaId) {

        status.textContent =
            "❌ Empresa não encontrada.";

        return;

    }


    // =================================
    // MOSTRAR MENSAGEM
    // =================================

    adicionarMensagemUsuario(
        texto
    );


    mensagem.value = "";


    status.textContent =
        "🤖 A IA está a responder...";


    // =================================
    // INDICADOR
    // =================================

    const carregando =
        document.createElement(
            "div"
        );


    carregando.id =
        "carregando";


    carregando.innerHTML = `

        <div class="card glow">

            🤖 A pensar...

        </div>

    `;


    chat.appendChild(
        carregando
    );


    chat.scrollTop =
        chat.scrollHeight;


    try {

        // =================================
        // CRIAR / RECUPERAR CLIENTE
        // =================================

        const cliente =
            await obterClienteTeste();


        if (!cliente) {

            throw new Error(
                "Não foi possível criar o cliente de teste."
            );

        }


        console.log(
            "👤 Cliente associado:",
            cliente
        );


        // =================================
        // CHAMAR EDGE FUNCTION
        // =================================

        console.log(
            "📨 Enviando para closer-ai-test..."
        );


        const {
            data,
            error
        } = await supabaseClient.functions.invoke(
            "closer-ai-test",
            {

                body: {

                    mensagem:
                        texto,

                    conhecimento:
                        conhecimento || {}

                }

            }
        );


        console.log(
            "📥 Resposta:",
            data
        );


        if (error) {

            console.error(
                "❌ Erro da Edge Function:",
                error
            );

            throw error;

        }


        // =================================
        // REMOVER CARREGAMENTO
        // =================================

        if (carregando) {

            carregando.remove();

        }


        // =================================
        // RESPOSTA
        // =================================

        const resposta =
            data?.resposta ||
            data?.message ||
            "A IA não retornou uma resposta.";


        adicionarMensagemIA(
            resposta
        );


        // =================================
        // GUARDAR CONVERSA
        // =================================

        const {
            error: salvarErro
        } = await supabaseClient

            .from("conversas")

            .insert({

                empresa_id:
                    empresaId,

                cliente_id:
                    cliente.id,

                mensagem_cliente:
                    texto,

                resposta_ia:
                    resposta,

                canal:
                    "Teste da IA"

            });


        if (salvarErro) {

            console.error(
                "❌ Erro ao guardar conversa:",
                salvarErro
            );


            status.textContent =
                "🟡 Resposta recebida, mas a conversa não foi guardada.";

        } else {

            console.log(
                "💾 Conversa guardada."
            );


            console.log(
                "👤 Cliente:",
                cliente.id
            );


            status.textContent =
                "🟢 Resposta recebida e conversa guardada.";

        }


        chat.scrollTop =
            chat.scrollHeight;


    } catch (error) {

        console.error(
            "❌ Erro completo:",
            error
        );


        if (carregando) {

            carregando.remove();

        }


        chat.innerHTML += `

            <div style="
                margin:15px 0;
            ">

                <div class="card">

                    ❌ Erro ao contactar o servidor da IA.

                </div>

            </div>

        `;


        status.textContent =
            "🔴 " + (
                error.message ||
                "Erro ao contactar a IA."
            );

    }

}


// =====================================
// LIMPAR CHAT DA TELA
// =====================================

btnLimpar.addEventListener(
    "click",
    function() {

        chat.innerHTML = `

            <div class="message ia">

                🤖 Olá!

                Sou o seu vendedor IA.

                Como posso ajudar?

            </div>

        `;


        status.textContent =
            "🟢 IA pronta para responder.";

    }
);


// =====================================
// PROTEÇÃO HTML
// =====================================

function escaparHTML(
    texto
) {

    const div =
        document.createElement(
            "div"
        );


    div.textContent =
        String(texto);


    return div.innerHTML;

}


// =====================================
// INICIAR
// =====================================

async function iniciarChat() {

    await carregarIA();

    await carregarHistorico();

}


iniciarChat();